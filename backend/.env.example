# ============================================
# TripWay — Backend Environment
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================

# Server
PORT=5000
NODE_ENV=development

# ── LLM ────────────────────────────────────────────────────
# Groq is used for llama-3.3-70b-versatile (primary LLM)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here   # optional

# Geoapify — tourist attractions & places of interest
# Sign up: https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# AviationStack — flight search
# Sign up: https://aviationstack.com/
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
# Base URL defaults to http://api.aviationstack.com/v1:
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# ── Security ────────────────────────────────────────────────
# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
