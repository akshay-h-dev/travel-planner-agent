# ============================================
# TripWay — Frontend Environment
# ============================================
# Copy this file to .env.local for local dev.
# For production (Vercel), set these in the
# Vercel dashboard → Project → Settings → Environment Variables.
#
# Leave VITE_API_URL blank in local dev — Vite proxy
# handles /api → localhost:5000 automatically.
# Set to your Render backend URL in production.
# ============================================

# Backend API base URL (no trailing slash)
# Example: https://tripway-api.onrender.com
VITE_API_URL=
